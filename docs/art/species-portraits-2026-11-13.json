{
  "recordedOn": "2026-11-13",
  "author": "Smoebo",
  "credit": "Provided by Smoebo for Open Game Master, 2026-11-13.",
  "source": "Painted outside the repository's ComfyUI job list and supplied as 33 finished 256x256 WebP files with a contact sheet. The delivery did not include the generation tool, prompts or full-size originals, so data/placeholder-src holds none and scripts/generate-placeholders.mjs --reencode skips these plates. The scripts/placeholder-set.mjs entries describe the subjects for the silhouette generator and are not the prompts these paintings came from.",
  "missing": [
    "generation tool",
    "generation prompts",
    "full-size originals and their hashes"
  ],
  "encoding": "As supplied: cwebp -q 70 -sharp_yuv, 256x256. The three centaur plates were re-encoded once after a crop (entries carry the edit).",
  "subjectBasis": "Lineage names from ODM's bundled races (src/lib/srd/races.json): kobold, hobgoblin, satyr and centaur are SRD 5.1 monsters; the rest are ODM's generic-named lineages with restated mechanics. Every plate is an original painting; none reproduces a published illustration. Serpentfolk was checked against the yuan-ti on the SRD 5.1 OGL Product Identity list (see species notes).",
  "review": "Every plate inspected at full size and in a round crop at 96px and 40px on dark and light surrounds, 2026-11-13. Ten of the eleven pass as supplied; the centaur plates were re-cropped. The previews are species-portraits-2026-11-13.webp: one row per species (96px dark, 40px dark, 40px light for each gender), then the centaur plates as supplied and as shipped.",
  "addedBytes": 320192,
  "species": {
    "triton": {
      "subjectBasis": "Original sea-folk humanoid: blue-green skin, finned ears, a scaled mantle. ODM's triton lineage row (generic name, mechanics restated). Not on the watch list.",
      "readability": "Pass. The bubble and coral backgrounds of the masculine and feminine plates are busy, but the face is large, central and its blue skin carries at 40px on both surrounds."
    },
    "serpentfolk": {
      "subjectBasis": "Original snake-scaled humanoid head with a ridged crown and slit eyes. The lineage restates the yuan-ti pureblood's mechanics under a generic name; yuan-ti is on the SRD 5.1 OGL Product Identity list, so the plates were checked for that design: no cobra hood, no snake-headed arms, no serpent lower body, no yuan-ti iconography. Reads as generic folklore serpent-folk.",
      "readability": "Pass. The head fills the frame; the feminine and neutral plates are darker but the ridged scaled head keeps its silhouette at 40px."
    },
    "kobold": {
      "subjectBasis": "SRD 5.1 monster (Kobold stat block): a small draconic humanoid with a snout and short horns.",
      "readability": "Pass. The masculine plate is the lowest-contrast of the set (rust on dark amber), but the horned snout reads at 40px on both surrounds; the feminine and neutral read clearly."
    },
    "aarakocra": {
      "subjectBasis": "Original raptor-headed bird-folk (eagle, falcon, osprey), not drawn from a published aarakocra illustration. ODM's aarakocra lineage row.",
      "readability": "Pass. The strongest of the set: beak and head shape read at any size."
    },
    "hobgoblin": {
      "subjectBasis": "SRD 5.1 monster (Hobgoblin stat block): red-orange skin, long pointed ears, small tusks, banded armour.",
      "readability": "Pass. Red faces and ear points carry at 40px."
    },
    "satyr": {
      "subjectBasis": "SRD 5.1 monster (Satyr stat block): curling goat horns, pointed ears, pipes or a flute. Bust framing, so the horns carry the species rather than the legs.",
      "readability": "Pass. The horns are small at 40px but the face reads; horns are clear at 96px."
    },
    "fairy": {
      "subjectBasis": "Generic folklore fairy: translucent insect wings, pointed ears, a slight build. ODM's fairy lineage row.",
      "readability": "Pass. The wings frame the face and stay visible at 40px."
    },
    "owlfolk": {
      "subjectBasis": "Generic owl-headed folk (great horned owl, barn owl, snowy owl). ODM's owlfolk lineage row.",
      "readability": "Pass. Facial discs and eyes read at any size."
    },
    "centaur": {
      "subjectBasis": "SRD 5.1 monster (Centaur stat block): a person's torso on a horse's body, bow and quiver.",
      "readability": "Fail as provided: full-body figures, the face about 4px tall at 40px. Re-cropped toward the head and torso (see edit); the face is about 1.45x larger and reads at 40px, and the horse's back still shows along the bottom of the square card. In the round token the horse is mostly outside the circle; no circle crop of this composition can hold both a readable face and the horse body (they are about 160px apart in the 256px file)."
    },
    "rabbitfolk": {
      "subjectBasis": "Generic rabbit- and hare-headed folk. ODM's rabbitfolk lineage row.",
      "readability": "Pass. The upright ears read at any size."
    },
    "shifter": {
      "subjectBasis": "Generic feral-featured humanoid: beast ears, a wild mane, fangs, a fur mantle. ODM's shifter lineage row.",
      "readability": "Pass. Faces read at 40px; the ears and mane are clear at 96px."
    }
  },
